# Environment Configuration
ENV=production
DEBUG=False

# API Configuration
API_TITLE=Medical AI Analyzer
API_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/medical_ai
REDIS_URL=redis://localhost:6379/0

# Model Configuration
XRAY_MODEL_PATH=models/xray_model.pth
SKIN_MODEL_PATH=models/skin_model.pth
CONFIDENCE_THRESHOLD=0.65
REVIEW_THRESHOLD=0.75

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=medical-ai-production

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
