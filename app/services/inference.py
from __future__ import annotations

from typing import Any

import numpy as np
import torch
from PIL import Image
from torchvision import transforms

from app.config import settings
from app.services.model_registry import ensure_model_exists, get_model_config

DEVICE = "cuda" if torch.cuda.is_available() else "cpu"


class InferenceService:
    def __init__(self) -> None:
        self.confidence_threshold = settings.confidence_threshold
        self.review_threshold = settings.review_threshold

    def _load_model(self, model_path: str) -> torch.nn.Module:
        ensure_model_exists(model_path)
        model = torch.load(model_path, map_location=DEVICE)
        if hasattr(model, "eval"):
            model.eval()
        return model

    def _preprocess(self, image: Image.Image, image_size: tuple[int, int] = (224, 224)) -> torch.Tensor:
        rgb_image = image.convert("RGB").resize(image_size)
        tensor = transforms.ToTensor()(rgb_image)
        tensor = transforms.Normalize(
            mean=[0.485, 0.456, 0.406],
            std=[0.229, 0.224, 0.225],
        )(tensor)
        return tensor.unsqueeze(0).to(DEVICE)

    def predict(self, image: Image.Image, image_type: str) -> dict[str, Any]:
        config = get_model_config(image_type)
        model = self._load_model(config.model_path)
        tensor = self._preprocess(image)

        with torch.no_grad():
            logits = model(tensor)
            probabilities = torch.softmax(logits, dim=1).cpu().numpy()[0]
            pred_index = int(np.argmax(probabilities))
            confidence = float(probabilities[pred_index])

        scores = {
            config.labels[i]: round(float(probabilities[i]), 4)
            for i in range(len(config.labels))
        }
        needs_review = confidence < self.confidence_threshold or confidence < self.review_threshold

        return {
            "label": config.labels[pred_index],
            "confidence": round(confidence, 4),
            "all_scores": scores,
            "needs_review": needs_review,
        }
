from dataclasses import dataclass
from pathlib import Path

from app.config import settings


@dataclass(frozen=True)
class ModelConfig:
    image_type: str
    model_path: str
    labels: list[str]


def get_model_config(image_type: str) -> ModelConfig:
    image_type = image_type.lower()
    if image_type == "xray":
        return ModelConfig(
            image_type="xray",
            model_path=settings.xray_model_path,
            labels=["Normal", "Pneumonia", "Lung Opacity", "Tuberculosis"],
        )
    if image_type == "skin":
        return ModelConfig(
            image_type="skin",
            model_path=settings.skin_model_path,
            labels=["Actinic Keratosis", "Basal Cell Carcinoma", "Melanoma", "Nevus", "Other"],
        )
    raise ValueError("image_type must be 'xray' or 'skin'")


def ensure_model_exists(model_path: str) -> None:
    path = Path(model_path)
    if not path.exists():
        raise FileNotFoundError(
            f"Model file not found: {model_path}. Train or place the artifact in models/."
        )
