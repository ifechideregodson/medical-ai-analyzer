from functools import lru_cache
from typing import List

from pydantic import Field
from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        case_sensitive=False,
        extra="ignore",
    )

    app_name: str = Field(default="Medical AI Analyzer")
    environment: str = Field(default="production")
    debug: bool = Field(default=False)
    api_title: str = Field(default="Medical AI Analyzer")
    api_version: str = Field(default="1.0.0")
    api_host: str = Field(default="0.0.0.0")
    api_port: int = Field(default=8000)

    database_url: str = Field(default="postgresql://user:password@localhost:5432/medical_ai")
    redis_url: str = Field(default="redis://localhost:6379/0")

    xray_model_path: str = Field(default="models/xray_model.pth")
    skin_model_path: str = Field(default="models/skin_model.pth")
    confidence_threshold: float = Field(default=0.65)
    review_threshold: float = Field(default=0.75)

    secret_key: str = Field(default="change-me-in-production")
    allowed_origins: str = Field(default="http://localhost:3000,http://localhost:8501")

    mlfow_tracking_uri: str = Field(default="http://localhost:5000")
    mlfow_experiment_name: str = Field(default="medical-ai-production")

    log_level: str = Field(default="INFO")
    log_file: str = Field(default="logs/app.log")

    @property
    def allowed_origin_list(self) -> List[str]:
        return [origin.strip() for origin in self.allowed_origins.split(",") if origin.strip()]


@lru_cache
def get_settings() -> Settings:
    return Settings()


settings = get_settings()
